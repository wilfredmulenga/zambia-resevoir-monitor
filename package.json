{
  "name": "zambia-water-map",
  "version": "1.0.0",
  "description": "Zambia Reservoir Monitor - powered by Global Water Watch satellite data",
  "main": "dist/server.js",
  "scripts": {
    "dev:server": "ts-node-dev --respawn --project tsconfig.server.json src/server.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.js",
    "import": "ts-node --project tsconfig.server.json src/scripts/import-reservoirs.ts"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@vis.gl/react-maplibre": "^8.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.7"
  }
}
